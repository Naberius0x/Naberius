-- ── KORBLOX / HEADLESS ────────────────────
-- Korblox: 오른쪽 다리 139607718
-- Headless: 머리 15093053680
-- 아바타 변경은 클라이언트 측 비주얼 적용 (HumanoidDescription)

local function applyKorbloxHeadless(useKorblox, useHeadless)
    local char = Player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass('Humanoid')
    if not hum then return end

    local desc = hum:GetAppliedDescription()

    if useKorblox then
        desc.RightLeg = 139607718
    else
        desc.RightLeg = 0
    end

    if useHeadless then
        desc.Head = 15093053680
        -- 머리 메시 숨기기
        pcall(function()
            local head = char:FindFirstChild('Head')
            if head then
                for _, v in pairs(head:GetChildren()) do
                    if v:IsA('SpecialMesh') then v.Scale = Vector3.new(0,0,0) end
                end
            end
        end)
    end

    pcall(function()
        hum:ApplyDescription(desc)
    end)
end

